# ============================================================
# 繋がるクラフト・プラットフォーム 環境変数
# すべて未設定でもアプリは「デモモード」(モックデータ)で動作します。
# 本番接続する場合のみ、以下を設定してください。
# ============================================================

# ---- Firebase (認証 / Firestore / FCMプッシュ通知) ----
# Firebase コンソール > プロジェクトの設定 > 全般 から取得
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=
# Cloud Messaging > ウェブプッシュ証明書 (VAPID キー)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=

# ---- Stripe (クレジットカード決済) ----
# 決済手数料 3.6% (国内カード) を販売価格に織り込むこと
STRIPE_SECRET_KEY=
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=
STRIPE_WEBHOOK_SECRET=

# ---- Google Calendar (本部の空き時間確認 / Zoom予約) ----
# サービスアカウント方式を推奨。ここでは検証用にアクセストークン直指定も可。
GOOGLE_CALENDAR_ID=primary
GOOGLE_CALENDAR_ACCESS_TOKEN=

# ---- アプリ ----
NEXT_PUBLIC_APP_URL=http://localhost:3000
